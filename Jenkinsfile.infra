// Applies the platform layer only (EKS, ECR, OIDC). The Jenkins host and the
// network live in the bootstrap layer, which this pipeline never applies - if
// it did, a change to the Jenkins instance would replace the machine running
// the build. Bootstrap is applied by hand; see docs/SETUP_GUIDE.md.
pipeline {
    agent any

    environment {
        AWS_REGION     = 'ap-south-1'
        EKS_CLUSTER    = 'herovire-eks'
        TF_PLATFORM    = 'terraform/platform'
        TF_BOOTSTRAP   = 'terraform/bootstrap'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform -chdir=$TF_PLATFORM init -input=false'
                sh 'terraform -chdir=$TF_PLATFORM apply -input=false -auto-approve'
            }
        }

        stage('Ansible Configure') {
            steps {
                script {
                    // Read-only: the Jenkins host address comes from the bootstrap
                    // state. This pipeline reads that state but never applies it.
                    sh 'terraform -chdir=$TF_BOOTSTRAP init -input=false'
                    // Private address: reaching the host's own public IP would exit
                    // through the IGW and come back with a source the SG rejects.
                    def jenkinsIp = sh(
                        script: 'terraform -chdir=$TF_BOOTSTRAP output -raw jenkins_private_ip',
                        returnStdout: true
                    ).trim()
                    writeFile file: 'ansible/inventory.ini', text: "[jenkins]\n${jenkinsIp}\n"
                }
                withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-ssh-key', keyFileVariable: 'SSH_KEY')]) {
                    dir('ansible') {
                        sh 'ansible-playbook -i inventory.ini configure-nodes.yml --private-key $SSH_KEY'
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER
                    kubectl get nodes
                '''
            }
        }
    }

    post {
        failure {
            mail to: 'eiron.rohit@gmail.com',
                 subject: "Infra pipeline failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Pipeline failed. Details: ${env.BUILD_URL}"
        }
    }
}
